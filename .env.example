# ---- Required for live modes (preview / full). Never commit the real .env ----
OPENROUTER_API_KEY=

# ---- OpenRouter ----
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional app attribution headers (leave empty to send none)
APP_REFERER=
APP_TITLE=

# ---- Models (verify ids with `studio check`; several agents may share one LLM) ----
LLM_MODEL=google/gemini-3-flash-preview
DIRECTOR_MODEL=google/gemini-3-flash-preview
VISION_MODEL=google/gemini-3-flash-preview
# Stronger model used only by the thumbnail branch (thumbnail prompt, its judge, and the two image
# reviews). Must accept image input. A few calls per video. Leave empty to use LLM_MODEL/VISION_MODEL.
THUMBNAIL_MODEL=anthropic/claude-sonnet-5.5
# Stronger image model used only for the thumbnail (at most MAX_THUMBNAIL_ATTEMPTS images per video).
# Leave empty to use IMAGE_MODEL.
THUMBNAIL_IMAGE_MODEL=google/gemini-3-pro-image
IMAGE_MODEL=google/gemini-2.5-flash-image
# Stronger image model used only to redraw a shot image the Visual Judge rejected. The first picture
# of every shot still comes from IMAGE_MODEL. Leave empty to redraw with IMAGE_MODEL.
IMAGE_RETRY_MODEL=google/gemini-3-pro-image
VIDEO_MODEL=google/veo-3.1
TTS_MODEL=google/gemini-3.8-flash-lite-tts
# Optional: enables transcription comparison in Audio QA (e.g. openai/whisper-large-v3)
STT_MODEL=
# json_object | json_schema | none  (how structured output is requested from the LLM)
LLM_JSON_MODE=json_object

# ---- Video format ----
FORMAT_TEMPLATE=Your Life as Every Rank in {topic}
TARGET_DURATION_S=600
DURATION_TOLERANCE=0.10
WIDTH=1920
HEIGHT=1080
FPS=30
ASPECT_RATIO=16:9
LANGUAGE=English
WORDS_PER_MINUTE=150
MIN_CHAPTERS=5
MAX_CHAPTERS=10
TARGET_SHOT_SECONDS=8
CAPTIONS_ENABLED=true
# Optional .ttf used for captions and thumbnail text (default: Pillow's bundled font)
FONT_PATH=

# ---- Feature switches ----
ENABLE_IMAGES=true
ENABLE_VIDEO=false
ENABLE_TTS=true
# auto | on | off : pass character reference images to the image model
IMAGE_USE_REFERENCES=auto
MAX_REFERENCE_IMAGES=1
MAX_VIDEO_CLIPS=3
VIDEO_CLIP_SECONDS=4
VIDEO_RESOLUTION=720p

# ---- Voice ----
# Must be one of the model's voices (checked by `check --models`)
TTS_VOICE=Kore
# mp3 | pcm. Gemini TTS returns pcm only; pcm is wrapped into WAV locally
TTS_FORMAT=pcm
TTS_SPEED=1.0
# auto | on | off : send the `instructions` field to the TTS model
TTS_INSTRUCTIONS=auto
# Used for pcm only when the response does not state its sample rate
TTS_PCM_SAMPLE_RATE=24000

# ---- Background music ----
# The Editor picks a track from MUSIC_DIR that fits the video's tone (public-domain CC0 tracks are
# included; see assets/music/README.md). false = narration only.
ENABLE_MUSIC=true
MUSIC_DIR=assets/music
# Optional: force one specific file instead of the library (both values required)
MUSIC_PATH=
MUSIC_LICENSE=
MUSIC_VOLUME=0.12

# ---- Judges and retries ----
PROMPT_JUDGE_THRESHOLD=0.7
VISUAL_JUDGE_THRESHOLD=0.7
THUMBNAIL_THRESHOLD=0.7
MAX_SCRIPT_ATTEMPTS=3
MAX_STORYBOARD_ATTEMPTS=3
MAX_PROMPT_ATTEMPTS=3
MAX_VISUAL_ATTEMPTS=3
MAX_AUDIO_ATTEMPTS=2
MAX_THUMBNAIL_ATTEMPTS=3
MAX_LLM_REPAIR_ATTEMPTS=2

# ---- Paths ----
DATA_DIR=data
OUTPUT_DIR=output
REFERENCES_DIR=data/references

# ---- API behaviour ----
API_TIMEOUT_S=120
API_MAX_RETRIES=3
VIDEO_POLL_INTERVAL_S=15
VIDEO_TIMEOUT_S=900
# Connect over IPv4 only (prevents ~1 minute stalls per connection where IPv6 is broken)
FORCE_IPV4=true

# ---- Cost control ----
MAX_BUDGET_USD=5.00
MAX_MEDIA_REQUESTS=150

# ---- Live preview sizing ----
PREVIEW_DURATION_S=60
# A preview's final video is accepted between these lengths (inclusive). Real narration rarely
# matches the word-count estimate exactly; the video is never stretched or trimmed to fit.
PREVIEW_MIN_DURATION_S=50
PREVIEW_MAX_DURATION_S=80
PREVIEW_MAX_CHAPTERS=2

# ---- Dry run (no API calls; labelled sample assets) ----
DRY_RUN_WIDTH=640
DRY_RUN_HEIGHT=360
DRY_RUN_FPS=15
# Sample judges reject one prompt and one thumbnail once, to demonstrate the revision loops
DRY_RUN_DEMO_REJECTIONS=true
